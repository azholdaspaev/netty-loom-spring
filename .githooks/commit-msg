#!/usr/bin/env bash
# Enforces the shape .gitmessage describes. Enable once per clone:
#   git config core.hooksPath .githooks
set -eu
export LC_ALL=C

# git drops comment lines and the -v diff below the scissors only when an editor wrote the
# message; on every other path it sets GIT_EDITOR=: for the hook (githooks(5)) and keeps them.
if [ "${GIT_EDITOR-}" = : ]; then
  msg=$(cat "$1")
else
  msg=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$1")
fi
msg=$(printf '%s\n' "$msg" | sed -e 's/[[:space:]]*$//' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
subject=$(printf '%s\n' "$msg" | sed -n '/./{p;q;}')

case "$subject" in
  fixup!\ *|squash!\ *) exit 0 ;;
  Merge\ branch\ *|Merge\ pull\ request\ *|Merge\ remote-tracking\ branch\ *|Merge\ tag\ *|Revert\ \"*) exit 0 ;;
esac

fail() {
  printf 'commit-msg: %s\n  see .gitmessage\n' "$1" >&2
  exit 1
}

printf '%s' "$subject" | grep -qE '^NL-[0-9]+ [A-Z]' \
  || fail "subject must be 'NL-<issue> <Imperative summary>' (NL-01 when there is no issue)"
[ "${#subject}" -le 72 ] || fail "subject is ${#subject} chars; the limit is 72"
case "$subject" in *.) fail "subject must not end with a period" ;; esac
[ "${#msg}" -le 500 ] || fail "message is ${#msg} chars; the limit is 500 for subject, body and Closes line together"
printf '%s' "$msg" | grep -q '[^ -~[:space:]]' \
  && fail "message must be ASCII only: -- for an em dash, -> for an arrow" || true
printf '%s\n' "$msg" | grep -qiE '^(Claude-Session|Co-authored-by|Signed-off-by|Generated-by):|^Generated with|https://claude\.ai/code/' \
  && fail "no trailers: no session links, no Co-authored-by, no Signed-off-by, no generated-by footer" || true
