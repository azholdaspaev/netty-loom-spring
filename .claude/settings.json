{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "mcp__idea__rename_refactoring",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *-X=PUT*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method=PUT*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *repos/azholdaspaev/netty-loom-spring)",
      "Bash(gh api *repos/azholdaspaev/netty-loom-spring *)",
      "Bash(gh api *repos/{owner}/{repo})",
      "Bash(gh api *repos/{owner}/{repo} *)",
      "Bash(gh api *repos/:owner/:repo)",
      "Bash(gh api *repos/:owner/:repo *)",
      "Bash(gh api graphql *RepositoryRuleset*)",
      "Bash(gh api *labels*)",
      "Bash(gh api graphql *markPullRequestReadyForReview*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *addLabelsToLabelable*)",
      "Bash(gh api graphql *removeLabelsFromLabelable*)",
      "Bash(gh repo *)",
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git commit *--no-verify*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr edit *--add-label*)",
      "Bash(gh pr edit *--remove-label*)",
      "Bash(gh issue edit *--add-label*)",
      "Bash(gh issue edit *--remove-label*)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(./gradlew *publish*)"
    ],
    "allow": [
      "Bash(./gradlew *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ]
  }
}
