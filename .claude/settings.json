{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "mcp__idea__rename_refactoring"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r .tool_input.file_path) || exit 2; case \"$f\" in *.java) \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/check-comments.sh \"$f\" || exit 2 ;; esac"
          }
        ]
      }
    ]
  }
}
