{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "mcp__idea__rename_refactoring",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *--method PUT*)",
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git commit *--no-verify*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)"
    ],
    "allow": [
      "Bash(./gradlew *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ]
  }
}
