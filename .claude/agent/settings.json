{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh *",
      "git push *",
      "git ls-remote *",
      ".claude/scripts/pr-comments.sh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.gradle",
        "/var/folders"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "strictAllowlist": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "repo.maven.apache.org",
        "plugins.gradle.org",
        "plugins-artifacts.gradle.org",
        "central.sonatype.com",
        "spring.io",
        "*.spring.io",
        "netty.io",
        "tomcat.apache.org",
        "k6.io",
        "*.k6.io",
        "grafana.com"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh pr edit *--add-label*)",
      "Bash(gh pr edit *--remove-label*)",
      "Bash(gh issue edit *--add-label*)",
      "Bash(gh issue edit *--remove-label*)",
      "Bash(gh pr create *--label*)",
      "Bash(gh pr create *-l *)",
      "Bash(gh pr create *-l=*)",
      "Bash(gh issue create *--label*agent/*)",
      "Bash(gh issue create *-l *agent/*)",
      "Bash(gh issue create *-l=*agent/*)",
      "Bash(gh api */labels*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-X=DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-XPATCH*)",
      "Bash(gh api *-X=PATCH*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method=PATCH*)",
      "Bash(gh api graphql *markPullRequestReadyForReview*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *addLabelsToLabelable*)",
      "Bash(gh api graphql *removeLabelsFromLabelable*)"
    ]
  }
}
